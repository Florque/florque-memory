#!/usr/bin/env sh
# Runs the memory-engine CLI: the installed command if present, otherwise the
# repo checkout this skill lives in (via uv). Set MEMORY_ENGINE_HOME to override.
set -e
if command -v memory-engine >/dev/null 2>&1; then
  exec memory-engine "$@"
fi
skill_dir="$(cd "$(dirname "$0")/.." && pwd -P)"
repo="${MEMORY_ENGINE_HOME:-$(cd "$skill_dir/../.." && pwd -P)}"
exec uv run --quiet --project "$repo" memory-engine "$@"
